<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>FreeYouTubeConverterStudio</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- Unpackaged + self-contained: just run the .exe, no MSIX / installer needed -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationTitle>Free YouTube Converter Studio</ApplicationTitle>
    <Version>2.0.0</Version>
    <!-- Icon of the .exe (Explorer, taskbar pin, Start menu, Alt+Tab fallback) -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <!-- Shown in Explorer → file Properties → Details -->
    <Product>Free YouTube Converter Studio</Product>
    <AssemblyTitle>Free YouTube Converter Studio</AssemblyTitle>
    <Description>Download and convert YouTube videos and playlists.</Description>
    <Copyright>Copyright © 2026</Copyright>
    <!-- Stop Visual Studio's generated "Debugger.Break()" on unhandled exceptions so the app's own
         handler runs and writes crash.log. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_BREAK_ON_UNHANDLED_EXCEPTION</DefineConstants>
  </PropertyGroup>

  <!-- Logo files must sit next to the exe so ms-appx:///Assets/... and AppWindow.SetIcon can find them -->
  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.*" />
    <PackageReference Include="YoutubeExplode" Version="6.*" />
    <PackageReference Include="YoutubeExplode.Converter" Version="6.*" />
  </ItemGroup>

</Project>
