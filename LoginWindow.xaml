<Window
    x:Class="FreeYouTubeConverterStudio.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="20,14" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="Sign in to YouTube" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock x:Name="StatusText"
                           Text="Sign in with your Google account, then click “Save login”."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <Button x:Name="SaveButton" Grid.Column="1" Style="{StaticResource AccentButtonStyle}"
                    Click="Save_Click" IsEnabled="False" MinWidth="130">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74E;" FontSize="14" />
                    <TextBlock Text="Save login" />
                </StackPanel>
            </Button>

            <Button Grid.Column="2" Content="Cancel" Click="Cancel_Click" />
        </Grid>

        <InfoBar x:Name="Info" Grid.Row="1" IsOpen="False" IsClosable="True" Margin="20,0,20,8" />

        <controls:WebView2 x:Name="Web" Grid.Row="2" />
    </Grid>
</Window>
