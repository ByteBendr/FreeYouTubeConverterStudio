<Page
    x:Class="FreeYouTubeConverterStudio.Pages.DownloadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:FreeYouTubeConverterStudio.Models"
    NavigationCacheMode="Required"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop">

    <Page.Resources>
        <Style x:Key="QueueItemContainerStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
    </Page.Resources>

    <Grid Background="Transparent" Padding="36,8,36,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="Download" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Paste a video or playlist link, pick a format, and add it to the queue."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Add to queue card -->
        <Border Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
            <Grid RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="UrlBox"
                             PlaceholderText="https://www.youtube.com/watch?v=…  or  a playlist link"
                             KeyDown="UrlBox_KeyDown" />
                    <Button Grid.Column="1" Click="Paste_Click" ToolTipService.ToolTip="Paste from clipboard">
                        <FontIcon Glyph="&#xE77F;" FontSize="16" />
                    </Button>
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="CmbFormat" Grid.Column="0" Header="Format" Width="190"
                              SelectionChanged="CmbFormat_SelectionChanged" />
                    <ComboBox x:Name="CmbQuality" Grid.Column="1" Header="Quality" Width="140" />

                    <ProgressRing x:Name="AddRing" Grid.Column="2" Width="22" Height="22"
                                  IsActive="False" Visibility="Collapsed"
                                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,6" />

                    <Button x:Name="AddButton" Grid.Column="3" Style="{StaticResource AccentButtonStyle}"
                            VerticalAlignment="Bottom" Click="Add_Click" MinWidth="150">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="Add to queue" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- Status bar -->
        <InfoBar x:Name="Info" Grid.Row="2" IsOpen="False" IsClosable="True" />

        <!-- Queue -->
        <Grid Grid.Row="3">
            <ListView x:Name="QueueList"
                      ItemsSource="{x:Bind Queue}"
                      SelectionMode="None"
                      IsItemClickEnabled="False"
                      ItemContainerStyle="{StaticResource QueueItemContainerStyle}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:DownloadItem">
                        <Grid Padding="12"
                              ColumnSpacing="14"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              BorderThickness="1"
                              CornerRadius="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Thumbnail -->
                            <Border Width="128" Height="72" CornerRadius="6">
                                <Border.Background>
                                    <ImageBrush ImageSource="{x:Bind Thumbnail}" Stretch="UniformToFill" />
                                </Border.Background>
                                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6"
                                        Padding="5,1" CornerRadius="4" Background="#CC000000"
                                        Visibility="{x:Bind DurationVisibility}">
                                    <TextBlock Text="{x:Bind DurationText}" FontSize="11" Foreground="White" />
                                </Border>
                            </Border>

                            <!-- Info -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}"
                                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                                <TextBlock Text="{x:Bind Subtitle}" FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" MaxLines="1" />
                                <ProgressBar Maximum="100" Margin="0,4,0,0"
                                             Value="{x:Bind ProgressValue, Mode=OneWay}"
                                             IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                                             Visibility="{x:Bind ProgressVisibility, Mode=OneWay}" />
                                <Grid>
                                    <TextBlock Text="{x:Bind StatusText, Mode=OneWay}"
                                               Foreground="{x:Bind StatusBrush, Mode=OneWay}"
                                               FontSize="12" TextTrimming="CharacterEllipsis" MaxLines="1"
                                               ToolTipService.ToolTip="{x:Bind StatusText, Mode=OneWay}" />
                                    <TextBlock HorizontalAlignment="Right" FontSize="12"
                                               Text="{x:Bind ProgressText, Mode=OneWay}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Visibility="{x:Bind ProgressVisibility, Mode=OneWay}" />
                                </Grid>
                            </StackPanel>

                            <!-- Row actions -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Style="{StaticResource SubtleButtonStyle}" Click="ItemCancel_Click"
                                        Visibility="{x:Bind CancelVisibility, Mode=OneWay}"
                                        ToolTipService.ToolTip="Cancel">
                                    <FontIcon Glyph="&#xE711;" FontSize="14" />
                                </Button>
                                <Button Style="{StaticResource SubtleButtonStyle}" Click="ItemRemove_Click"
                                        Visibility="{x:Bind RemoveVisibility, Mode=OneWay}"
                                        ToolTipService.ToolTip="Remove from list">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Empty state -->
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <Image Source="ms-appx:///Assets/Logo.png" Width="96" Height="96" HorizontalAlignment="Center" />
                <TextBlock Text="Your queue is empty" Style="{StaticResource SubtitleTextBlockStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Paste a link above, or drop one anywhere on this page."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Toolbar -->
        <Grid Grid.Row="4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="StartButton" Style="{StaticResource AccentButtonStyle}" Click="Start_Click" MinWidth="130">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE768;" FontSize="14" />
                    <TextBlock Text="Start queue" />
                </StackPanel>
            </Button>

            <Button x:Name="StopButton" Grid.Column="1" Click="Stop_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE71A;" FontSize="14" />
                    <TextBlock Text="Stop all" />
                </StackPanel>
            </Button>

            <Button x:Name="ClearButton" Grid.Column="2" Click="Clear_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                    <TextBlock Text="Clear finished" />
                </StackPanel>
            </Button>

            <TextBlock x:Name="SummaryText" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right"
                       Margin="0,0,12,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <Button Grid.Column="4" Click="OpenFolder_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                    <TextBlock Text="Open folder" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
